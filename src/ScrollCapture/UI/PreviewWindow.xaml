<Window x:Class="ScrollCapture.UI.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="长截图预览"
        Width="860"
        Height="640"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="InfoText"
                   Grid.Row="0"
                   Margin="12,10,12,4"
                   Foreground="#FF707070"
                   FontSize="12"
                   TextWrapping="Wrap" />

        <Border Grid.Row="1"
                Background="#FF1E1E24"
                Margin="0,0,0,8">
            <ScrollViewer x:Name="Scroll"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="#FF1E1E24">
                <Grid x:Name="Viewport">
                    <Image x:Name="PreviewImage"
                           Stretch="None"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           MouseWheel="OnImageMouseWheel" />
                </Grid>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Background="#FFF5F5F5"
                Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="复制图片" Click="OnCopyClick" Padding="18,6" Margin="0,0,8,0" />
                <Button Content="保存 PNG" Click="OnSavePngClick" Padding="18,6" Margin="0,0,8,0" />
                <Button Content="保存 JPG" Click="OnSaveJpgClick" Padding="18,6" Margin="0,0,8,0" />
                <Button Content="重新截取" Click="OnRetakeClick" Padding="18,6" Margin="0,0,8,0" />
                <Button Content="打开所在文件夹" Click="OnOpenFolderClick" Padding="18,6" Margin="0,0,14,0" />
                <TextBlock Text="滚轮缩放 · Ctrl+滚轮平移"
                           Foreground="#FF999999"
                           VerticalAlignment="Center"
                           FontSize="11" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
