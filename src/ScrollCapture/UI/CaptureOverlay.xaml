<Window x:Class="ScrollCapture.UI.CaptureOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScrollCapture Selection"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Cursor="Cross"
        Focusable="True"
        UseLayoutRounding="True">
    <Canvas x:Name="Layer" Focusable="True" Background="Transparent">
        <Path x:Name="DimPath" Fill="#50101A26" />
        <Rectangle x:Name="SelRect"
                   Stroke="#FF1E90FF"
                   Fill="#1A1E90FF"
                   StrokeThickness="1"
                   Visibility="Collapsed" />
        <TextBlock x:Name="SizeLabel"
                   Foreground="White"
                   Background="#CC203040"
                   FontSize="12"
                   Padding="6,3"
                   Visibility="Collapsed"
                   IsHitTestVisible="False" />
        <TextBlock x:Name="HintLabel"
                   Text="拖动选择区域 · 松开完成 · ESC / 右键取消"
                   Foreground="White"
                   Background="#66203040"
                   FontSize="12"
                   Padding="8,4"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="12,12,0,0"
                   IsHitTestVisible="False" />
    </Canvas>
</Window>
