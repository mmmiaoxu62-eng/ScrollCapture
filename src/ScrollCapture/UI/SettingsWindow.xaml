<Window x:Class="ScrollCapture.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScrollCapture 设置"
        Width="480"
        Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="全局快捷键" FontWeight="SemiBold" />
        <TextBox x:Name="HotkeyBox"
                 IsReadOnly="True"
                 Margin="0,4,0,2"
                 Padding="8,6"
                 PreviewKeyDown="OnHotkeyKeyDown"
                 ToolTip="点击后直接按组合键（Ctrl+Alt+… 等），Backspace 清空" />
        <TextBlock Text="点击输入框后直接按组合键；不支持单键（需至少一个修饰键）"
                   FontSize="11"
                   Foreground="#FF888888" />

        <TextBlock Text="保存目录" FontWeight="SemiBold" Margin="0,16,0,4" />
        <DockPanel>
            <Button x:Name="BrowseButton" Content="浏览…" DockPanel.Dock="Right" Padding="12,5" Click="OnBrowseClick" />
            <TextBox x:Name="SaveDirBox" Padding="5,5" Margin="0,0,8,0" />
        </DockPanel>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="最大拼接高度 (px)" VerticalAlignment="Center" />
            <TextBox x:Name="MaxHeightBox" Grid.Column="1" Padding="5,5" />
        </Grid>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="最大自动滚动帧数" VerticalAlignment="Center" />
            <TextBox x:Name="MaxFramesBox" Grid.Column="1" Padding="5,5" />
        </Grid>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="自动滚动方向" VerticalAlignment="Center" />
            <ComboBox x:Name="DirectionBox" Grid.Column="1" Padding="5,5">
                <ComboBoxItem Content="向下（新内容在下）" />
                <ComboBoxItem Content="向上（历史在上）" />
            </ComboBox>
        </Grid>

        <CheckBox x:Name="AutoStartBox"
                  Content="开机自启（后台常驻托盘）"
                  Margin="0,16,0,0" />

        <StackPanel Orientation="Horizontal" Margin="0,24,0,0" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="取消" Padding="20,6" Margin="0,0,10,0" Click="OnCancelClick" />
            <Button x:Name="SaveButton" Content="保存" Padding="30,6" Click="OnSaveClick" />
        </StackPanel>
    </StackPanel>
</Window>
