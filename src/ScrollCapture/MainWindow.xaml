<Window x:Class="ScrollCapture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScrollCapture 截长屏"
        Width="460"
        Height="400"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        ShowActivated="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20">
        <TextBlock Text="ScrollCapture · 截长屏"
                   FontSize="16"
                   FontWeight="SemiBold" />

        <TextBlock Text="全局快捷键"
                   Margin="0,16,0,4"
                   Foreground="#FF606060" />
        <Border Background="#FFF2F2F2"
                CornerRadius="4"
                Padding="10,6">
            <TextBlock x:Name="HotkeyText"
                       FontSize="14"
                       FontWeight="SemiBold" />
        </Border>

        <Button x:Name="AutoCaptureButton"
                Margin="0,18,0,0"
                Padding="0,8"
                Content="开始截长屏（自动滚动）"
                Click="OnAutoCaptureClick" />
        <Button x:Name="SettingsButton"
                Margin="0,12,0,0"
                Padding="0,8"
                Content="设置…"
                Click="OnSettingsClick" />
        <Button x:Name="DiagnosticsButton"
                Margin="0,8,0,0"
                Padding="0,8"
                Content="导出诊断包…"
                Click="OnDiagnosticsClick" />

        <TextBlock x:Name="StatusText"
                   Margin="0,12,0,12"
                   TextWrapping="Wrap"
                   Foreground="#FF808080"
                   FontSize="12" />
    </StackPanel>
    </ScrollViewer>
</Window>
